# Cyvault - Environment Variables Template
# DO NOT commit the actual .env file to version control.
# Copy this file to .env and fill in your actual values.

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
ENVIRONMENT=development  # development, staging, production
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE (Supabase Postgres)
# -----------------------------------------------------------------------------
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_or_service_role_key
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# SECURITY & ENCRYPTION
# -----------------------------------------------------------------------------
# 32-byte (256-bit) base64 encoded key for AES-GCM encryption of merchant API keys
MASTER_ENCRYPTION_KEY=generate_a_secure_base64_string_here
JWT_SECRET=generate_a_secure_jwt_secret_here

# -----------------------------------------------------------------------------
# RAZORPAY API (Test Mode Only for Hackathon)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_secure_webhook_secret

#CyvaultSecureWebhook2026
# -----------------------------------------------------------------------------
# LLM PROVIDERS
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# -----------------------------------------------------------------------------
# CACHE & QUEUE (Upstash)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_qstash_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key
